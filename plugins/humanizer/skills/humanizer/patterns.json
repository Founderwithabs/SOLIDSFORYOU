  "constructions": [
    {
      "regex": "\\b(it'?s|this is|that'?s|this isn'?t|it isn'?t) (not )?(just|only|merely|simply) (a |an |about )?[^.?!]{1,50}?[,;—–-]+ ?(it'?s|but|this is)\\b",
      "name": "\"it's not just X, it's Y\"",
      "weight": 5
    },
    {
      "regex": "\\bnot (just|only) [^.?!]{1,50}? but (also )?",
      "name": "\"not only X but also Y\"",
      "weight": 4
    },
    {
      "regex": "\\bwhether you'?re [^.?!]{1,60}? or ",
      "name": "\"whether you're X or Y\"",
      "weight": 4
    },
    {
      "regex": "^(from|whether) [^.?!]{1,40}? to [^.?!]{1,40}?,",
      "name": "\"from X to Y,\" sweep",
      "weight": 3
    },
    {
      "regex": "\\b(imagine|picture this|picture a world)\\b",
      "name": "\"imagine...\"",
      "weight": 3
    },
    {
      "regex": "\\bwhat if (i told you|you could)\\b",
      "name": "\"what if I told you\"",
      "weight": 4
    },
    {
      "regex": "\\b(the (best|good) part|the result|the catch|the secret|the kicker|the answer|the truth|the twist|the problem)\\?",
      "name": "question-then-answer reveal",
      "weight": 4
    },
    {
      "regex": "\\bhere'?s (the thing|why\\b|the kicker|the deal|the truth|the secret)",
      "name": "\"here's the thing / here's why\"",
      "weight": 3
    },
    {
      "regex": "\\b(more than|beyond) just a\\b",
      "name": "\"more than just a\"",
      "weight": 4
    },
    {
      "regex": "\\bsay goodbye to [^.?!]{1,40}? (and|&) (say )?hello to\\b",
      "name": "\"say goodbye to X, hello to Y\"",
      "weight": 5
    },
    {
      "regex": "\\b(so,? )?what are you waiting for\\b",
      "name": "\"what are you waiting for\"",
      "weight": 4
    },
    {
      "regex": "\\bready to [^.?!]{1,40}\\?",
      "name": "\"Ready to X?\" call to action",
      "weight": 2
    },
    {
      "regex": "\\bit'?s time to\\b",
      "name": "\"it's time to\"",
      "weight": 2
    },
    {
      "regex": "\\bin a world (where|of)\\b",
      "name": "\"in a world where\"",
      "weight": 4
    },
    {
      "regex": "\\bthink of it as\\b",
      "name": "\"think of it as\"",
      "weight": 2
    },
    {
      "regex": "\\b(no|not) [a-z']+\\. (no|not) [a-z']+\\. (just|only|simply|pure)\\b",
      "name": "\"No X. No Y. Just Z.\"",
      "weight": 5
    },
    {
      "regex": "\\bisn'?t (just|only) (a|an|about)\\b",
      "name": "\"isn't just a\"",
      "weight": 4
    },
    {
      "regex": "\\bwe'?ve got you covered\\b",
      "name": "\"we've got you covered\"",
      "weight": 3
    },
    {
      "regex": "\\b(designed|crafted|engineered|built) (with|for) [^.?!]{0,30}(in mind|you)\\b",
      "name": "\"crafted with you in mind\"",
      "weight": 3
    },
    {
      "regex": "\\b(elevate|transform|revolutionize|upgrade) your [a-z]+ (game|routine|experience|life)\\b",
      "name": "\"elevate your X routine\"",
      "weight": 4
    },
    {
      "regex": "\\bnot [a-z]+, but [a-z]+\\b",
      "name": "\"not X, but Y\" antithesis",
      "weight": 2
    },
    {
      "regex": "\\b(dive|delve|jump) (into|in)\\b",
      "name": "\"dive into\"",
      "weight": 3
    }
  ],
